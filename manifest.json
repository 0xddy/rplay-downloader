{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.rplay.live/*",
    "*://*.rplay-cdn.com/*",
    "https://widevine-dash.ezdrm.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["*://rplay.live/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
